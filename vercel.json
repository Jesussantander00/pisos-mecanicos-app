{
  "crons": [
    {
      "path": "/api/telkonet?action=scan",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/telkonet?action=digest",
      "schedule": "0 12 * * *"
    }
  ],
  "functions": {
    "api/send-report.js": {
      "maxDuration": 30
    },
    "api/admin-actions.js": {
      "maxDuration": 60
    },
    "api/telkonet.js": {
      "maxDuration": 60
    },
    "api/generate.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/generate-procedure",
      "destination": "/api/generate?kind=procedure"
    },
    {
      "source": "/api/generate-reorder-notes",
      "destination": "/api/generate?kind=reorder-notes"
    },
    {
      "source": "/api/generate-schedule",
      "destination": "/api/generate?kind=schedule"
    },
    {
      "source": "/api/generate-weekly-summary",
      "destination": "/api/generate?kind=weekly-summary"
    }
  ]
}